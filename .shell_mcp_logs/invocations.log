{"timestamp": 1759745556.393681, "command": "cat > /tmp/add_embedded_mcp.py << 'EOF'\nimport json\n\n# Read current settings\nwith open('/home/torstein.sornes/.config/zed/settings.json', 'r') as f:\n    settings = json.load(f)\n\n# Add the embedded MCP server configuration\nsettings['context_servers']['zed-embedded-context'] = {\n    \"enabled\": True,\n    \"source\": \"custom\",\n    \"command\": \"socat\",\n    \"args\": [\n        \"-\",\n        \"UNIX-CONNECT:\" + open('/home/torstein.sornes/.zed/embedded_compaction_mcp_socket').read().strip()\n    ],\n    \"env\": {}\n}\n\n# Write back\nwith open('/home/torstein.sornes/.config/zed/settings.json', 'w') as f:\n    json.dump(settings, f, indent=2)\n\nprint(\"Added zed-embedded-context to MCP servers\")\nEOF\npython /tmp/add_embedded_mcp.py", "sudo": false, "timeout": false, "exit_code": 127, "duration_sec": 0.0271, "truncated_stdout": false, "truncated_stderr": false, "bytes_stdout": 0, "bytes_stderr": 123, "shell": "/usr/bin/fish", "cwd": "/home/torstein.sornes/code/zed", "allowed_env_keys": ["DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "HOME", "LANG", "PATH", "SHELL", "SSH_AUTH_SOCK", "SUDO_ASKPASS", "TERM", "WAYLAND_DISPLAY", "XAUTHORITY", "XDG_RUNTIME_DIR"], "env_origins": {"PATH": "inherited_base", "HOME": "inherited_base", "LANG": "inherited_base", "SHELL": "inherited_base", "TERM": "inherited_base", "DISPLAY": "inherited_gui", "WAYLAND_DISPLAY": "inherited_gui", "XDG_RUNTIME_DIR": "inherited_gui", "DBUS_SESSION_BUS_ADDRESS": "inherited_gui", "XAUTHORITY": "inherited_gui", "SSH_AUTH_SOCK": "inherited_gui", "SUDO_ASKPASS": "auto_default_askpass"}, "timeout_requested": 60, "timeout_effective": 60, "timeout_max": 60, "timeout_clamp_reason": null}
