{"timestamp": 1760427959.873432, "command": "git rev-parse --abbrev-ref HEAD || echo 'branch_error'\n# Fetch latest main (shallow) to ensure comparison is up to date\nif git rev-parse --verify origin/main >/dev/null 2>&1; then git fetch origin main --quiet; fi\n\ncurrent_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)\nbase_ref=origin/main\n\necho \"=== Branch ===\"\necho \"$current_branch vs $base_ref\"\n\necho \"=== High-level change summary (shortstat) ===\"\ngit diff --shortstat $base_ref...HEAD || echo 'no diff shortstat'\n\necho \"=== Name-status list ===\"\ngit diff --name-status $base_ref...HEAD\n\necho \"=== Directory breakdown ===\"\ngit diff --name-only $base_ref...HEAD | awk -F/ 'NF>0 {cnt[$1]++} END {for (d in cnt) printf \"%5d %s\\n\", cnt[d], d}' | sort -nr || echo 'no files'\n\necho \"=== Language breakdown (by extension) ===\"\ngit diff --name-only $base_ref...HEAD | awk -F. 'NF>1 {ext=$NF; cnt[ext]++} END {for (e in cnt) printf \"%5d %s\\n\", cnt[e], e}' | sort -nr || echo 'no files'\n\necho \"=== Added/Deleted line totals ===\"\ngit diff --numstat $base_ref...HEAD | awk '{adds+=$1; dels+=$2} END {printf \"Additions:%d Deletions:%d Net:%d\\n\", adds, dels, adds-dels}' || echo 'no stats'\n\necho \"=== Top 10 files by churn (additions+deletions) ===\"\ngit diff --numstat $base_ref...HEAD | awk '{churn=$1+$2; print churn\"\\t\"$0}' | sort -nr | head -10 | awk -F\"\\t\" '{print $2\" \"$3\" \"$4}'\n", "sudo": false, "timeout": false, "exit_code": 127, "duration_sec": 0.0414, "truncated_stdout": false, "truncated_stderr": false, "bytes_stdout": 0, "bytes_stderr": 243, "shell": "/usr/bin/fish", "cwd": "/home/torstein.sornes/code/zed-enhanced-terminal", "allowed_env_keys": ["DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "HOME", "LANG", "PATH", "SHELL", "SSH_AUTH_SOCK", "SUDO_ASKPASS", "TERM", "WAYLAND_DISPLAY", "XAUTHORITY", "XDG_RUNTIME_DIR"], "env_origins": {"PATH": "inherited_base", "HOME": "inherited_base", "LANG": "inherited_base", "SHELL": "inherited_base", "TERM": "inherited_base", "DISPLAY": "inherited_gui", "WAYLAND_DISPLAY": "inherited_gui", "XDG_RUNTIME_DIR": "inherited_gui", "DBUS_SESSION_BUS_ADDRESS": "inherited_gui", "XAUTHORITY": "inherited_gui", "SSH_AUTH_SOCK": "inherited_gui", "SUDO_ASKPASS": "auto_default_askpass"}, "async_job_id": "job_1760427959831_1", "timeout_requested": 59, "timeout_effective": 59, "timeout_clamp_reason": null}
