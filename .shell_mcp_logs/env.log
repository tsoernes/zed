{"timestamp": 1760427959.873432, "command": "git rev-parse --abbrev-ref HEAD || echo 'branch_error'\n# Fetch latest main (shallow) to ensure comparison is up to date\nif git rev-parse --verify origin/main >/dev/null 2>&1; then git fetch origin main --quiet; fi\n\ncurrent_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)\nbase_ref=origin/main\n\necho \"=== Branch ===\"\necho \"$current_branch vs $base_ref\"\n\necho \"=== High-level change summary (shortstat) ===\"\ngit diff --shortstat $base_ref...HEAD || echo 'no diff shortstat'\n\necho \"=== Name-status list ===\"\ngit diff --name-status $base_ref...HEAD\n\necho \"=== Directory breakdown ===\"\ngit diff --name-only $base_ref...HEAD | awk -F/ 'NF>0 {cnt[$1]++} END {for (d in cnt) printf \"%5d %s\\n\", cnt[d], d}' | sort -nr || echo 'no files'\n\necho \"=== Language breakdown (by extension) ===\"\ngit diff --name-only $base_ref...HEAD | awk -F. 'NF>1 {ext=$NF; cnt[ext]++} END {for (e in cnt) printf \"%5d %s\\n\", cnt[e], e}' | sort -nr || echo 'no files'\n\necho \"=== Added/Deleted line totals ===\"\ngit diff --numstat $base_ref...HEAD | awk '{adds+=$1; dels+=$2} END {printf \"Additions:%d Deletions:%d Net:%d\\n\", adds, dels, adds-dels}' || echo 'no stats'\n\necho \"=== Top 10 files by churn (additions+deletions) ===\"\ngit diff --numstat $base_ref...HEAD | awk '{churn=$1+$2; print churn\"\\t\"$0}' | sort -nr | head -10 | awk -F\"\\t\" '{print $2\" \"$3\" \"$4}'\n", "env": {"PATH": "/usr/sbin:/home/torstein.sornes/.cargo/bin:/home/torstein.sornes/.local/bin:/home/torstein.sornes/.pyenv/bin:/home/torstein.sornes/.local/share/pipx/venvs/basedpyright/bin:/home/torstein.sornes/scripts:/home/torstein.sornes/bin:/home/torstein.sornes/.config/emacs/bin:/home/torstein.sornes/.pixi/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/sbin:/var/lib/snapd/snap/bin", "HOME": "/home/torstein.sornes", "LANG": "en_US.UTF-8", "SHELL": "/usr/bin/fish", "TERM": "xterm-256color", "DISPLAY": ":0", "WAYLAND_DISPLAY": "wayland-0", "XDG_